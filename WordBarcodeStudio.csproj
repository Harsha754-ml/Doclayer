<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WordBarcodeStudio</AssemblyName>
    <RootNamespace>WordBarcodeStudio</RootNamespace>
    <AssemblyTitle>Word Barcode Studio</AssemblyTitle>
    <Product>Word Barcode Studio</Product>
  </PropertyGroup>

</Project>
