<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Doclayer installer.
    - EULA (License.rtf) is shown and must be accepted (WixUI_Mondo).
    - The user may choose the install folder (WIXUI_INSTALLDIR -> INSTALLFOLDER).
    - The user may choose which parts to install via the feature tree
      (Main application + optional Start Menu / Desktop shortcuts).
    - Application binaries live in Components.wxs, produced by `wix heat`
      from the published output, so this file never lists individual DLLs.
  -->

  <Package Name="Doclayer"
           Manufacturer="Doclayer"
           Version="$(var.ProductVersion)"
           UpgradeCode="A1B2C3D4-0001-4000-8000-000000000001"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Doclayer is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- ===== Features (what gets installed) ===== -->
    <Feature Id="MainApplication"
             Title="Doclayer Application"
             Level="1"
             Description="Core Doclayer application and all required files.">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <Feature Id="StartMenuShortcut"
             Title="Start Menu Shortcut"
             Level="1"
             Description="Adds a Doclayer shortcut to the Start Menu.">
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <Feature Id="DesktopShortcut"
             Title="Desktop Shortcut"
             Level="1"
             Description="Adds a Doclayer shortcut to the desktop.">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <!-- ===== Install locations ===== -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Doclayer" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Doclayer" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- ===== Shortcut components ===== -->
    <Component Id="StartMenuShortcutComponent"
               Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="StartMenuShortcut"
                Name="Doclayer"
                Target="[INSTALLFOLDER]Doclayer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Description="Generate barcodes with Microsoft Word" />
      <RemoveFolder Id="RemoveAppProgramsFolder"
                    Directory="ApplicationProgramsFolder"
                    On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Doclayer"
                     Name="StartMenuShortcut" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcutComponent"
               Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopShortcut"
                Name="Doclayer"
                Target="[INSTALLFOLDER]Doclayer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Description="Generate barcodes with Microsoft Word" />
      <RemoveFolder Id="RemoveDesktopFolder"
                    Directory="DesktopFolder"
                    On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Doclayer"
                     Name="DesktopShortcut" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>

    <!-- ===== UI ===== -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <UIRef Id="WixUI_Mondo" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Add/Remove Programs entries -->
    <Property Id="ARPNOREPAIR" Value="0" />
    <Property Id="ARPNOMODIFY" Value="0" />
  </Package>

</Wix>
