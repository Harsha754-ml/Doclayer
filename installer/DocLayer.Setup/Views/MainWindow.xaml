<Window x:Class="DocLayer.Setup.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DocLayer.Setup.ViewModels"
        xmlns:c="clr-namespace:DocLayer.Setup.Converters"
        Title="DocLayer Setup Wizard"
        Icon="../../Assets/AppIcon.ico"
        Width="760" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <c:BoolToVisConverter x:Key="BoolToVis" />
        <c:StepHighlightConverter x:Key="StepHighlight" />
        <c:StepBadgeBgConverter x:Key="StepBadgeBg" />
        <c:StepBadgeFgConverter x:Key="StepBadgeFg" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar (Step Indicators & Branding) -->
            <ColumnDefinition Width="220" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- LEFT SIDEBAR                                                 -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0"
                Padding="20,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="6" Background="#242424"
                                BorderBrush="#383838" BorderThickness="1" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconDocLayerGeo}" Fill="#FFFFFF"
                                  Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DocLayer" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Setup Wizard" FontSize="11" Foreground="#A1A1AA" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Step Timeline -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <!-- Step 1: Welcome -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{Binding IsWelcomeStep, Converter={StaticResource StepBadgeBg}}"
                                BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding IsWelcomeStep, Converter={StaticResource StepBadgeFg}}" />
                        </Border>
                        <TextBlock Text="Welcome" FontSize="13" VerticalAlignment="Center"
                                   FontWeight="{Binding IsWelcomeStep, Converter={StaticResource StepHighlight}}"
                                   Foreground="{Binding IsWelcomeStep, Converter={StaticResource StepHighlight}}" />
                    </StackPanel>

                    <!-- Step 2: EULA -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{Binding IsEulaStep, Converter={StaticResource StepBadgeBg}}"
                                BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding IsEulaStep, Converter={StaticResource StepBadgeFg}}" />
                        </Border>
                        <TextBlock Text="License Agreement" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{Binding IsEulaStep, Converter={StaticResource StepHighlight}}" />
                    </StackPanel>

                    <!-- Step 3: Destination -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{Binding IsDestinationStep, Converter={StaticResource StepBadgeBg}}"
                                BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding IsDestinationStep, Converter={StaticResource StepBadgeFg}}" />
                        </Border>
                        <TextBlock Text="Installation Location" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{Binding IsDestinationStep, Converter={StaticResource StepHighlight}}" />
                    </StackPanel>

                    <!-- Step 4: Diagnostics -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{Binding IsDiagnosticsStep, Converter={StaticResource StepBadgeBg}}"
                                BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="4" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding IsDiagnosticsStep, Converter={StaticResource StepBadgeFg}}" />
                        </Border>
                        <TextBlock Text="System Verification" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{Binding IsDiagnosticsStep, Converter={StaticResource StepHighlight}}" />
                    </StackPanel>

                    <!-- Step 5: Installation -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{Binding IsInstallingStep, Converter={StaticResource StepBadgeBg}}"
                                BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="5" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding IsInstallingStep, Converter={StaticResource StepBadgeFg}}" />
                        </Border>
                        <TextBlock Text="Installation" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{Binding IsInstallingStep, Converter={StaticResource StepHighlight}}" />
                    </StackPanel>

                    <!-- Step 6: Completed -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{Binding IsCompletedStep, Converter={StaticResource StepBadgeBg}}"
                                BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding IsCompletedStep, Converter={StaticResource StepBadgeFg}}" />
                        </Border>
                        <TextBlock Text="Finish" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{Binding IsCompletedStep, Converter={StaticResource StepHighlight}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Footer Version -->
                <TextBlock Grid.Row="2" Text="v1.0.0 Enterprise • 64-bit" FontSize="11" Foreground="#A1A1AA" />
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- MAIN CONTENT WIZARD                                          -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Step Content -->
                <RowDefinition Height="*" />
                <!-- Bottom Action Controls -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- STEP 0: WELCOME -->
            <Grid Grid.Row="0" Margin="28,24,28,16" Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Welcome to DocLayer Setup" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                    <TextBlock Text="DocLayer is a programmable document automation and barcode engine for Microsoft Word."
                               FontSize="13" Foreground="#E4E4E7" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" />

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Key Features:" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                            <TextBlock Text="• Microsoft Word DISPLAYBARCODE native vector rendering engine" FontSize="12" Foreground="#D4D4D8" Margin="0,0,0,6" />
                            <TextBlock Text="• Support for 8 barcode standards (QR, Code 128, EAN-13, UPC-A, etc.)" FontSize="12" Foreground="#D4D4D8" Margin="0,0,0,6" />
                            <TextBlock Text="• Multi-barcode batch document generation &amp; real-time preview" FontSize="12" Foreground="#D4D4D8" Margin="0,0,0,6" />
                            <TextBlock Text="• High-DPI Word (.docx) and PDF export pipeline" FontSize="12" Foreground="#D4D4D8" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Click Continue to review the License Agreement and configure installation options." FontSize="12" Foreground="#A1A1AA" />
                </StackPanel>
            </Grid>

            <!-- STEP 1: EULA -->
            <Grid Grid.Row="0" Margin="28,20,28,12" Visibility="{Binding IsEulaStep, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="End-User License Agreement" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Please review the license terms below. You must accept the agreement to proceed." FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0" />
                </StackPanel>

                <!-- License Text Box -->
                <TextBox Grid.Row="1" Text="{Binding EulaText, Mode=OneTime}"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"
                         Padding="12" Background="#101010" Foreground="#E4E4E7" Margin="0,0,0,12" />

                <!-- Radio Buttons -->
                <StackPanel Grid.Row="2">
                    <RadioButton Content="I accept the agreement" IsChecked="{Binding IsEulaAccepted, Mode=TwoWay}"
                                 Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <RadioButton Content="I do not accept the agreement" IsChecked="{Binding IsEulaAccepted, Converter={StaticResource BoolToVis}, ConverterParameter=invert, Mode=OneWay}"
                                 Foreground="#A1A1AA" />
                </StackPanel>
            </Grid>

            <!-- STEP 2: DESTINATION & SHORTCUTS -->
            <Grid Grid.Row="0" Margin="28,20,28,16" Visibility="{Binding IsDestinationStep, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Select Installation Location" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Choose the folder where DocLayer will be installed." FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,16" />

                    <!-- Path Input -->
                    <TextBlock Text="Destination Folder:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding BrowsePathCommand}" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Height="36" />
                    </Grid>

                    <!-- Additional Tasks Card -->
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Shortcut Options:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <CheckBox Content="Create a Desktop Shortcut" IsChecked="{Binding CreateDesktopShortcut}" Foreground="#E4E4E7" Margin="0,0,0,6" />
                            <CheckBox Content="Create a Start Menu Shortcut" IsChecked="{Binding CreateStartMenuShortcut}" Foreground="#E4E4E7" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- STEP 3: PRE-FLIGHT DIAGNOSTICS -->
            <Grid Grid.Row="0" Margin="28,20,28,16" Visibility="{Binding IsDiagnosticsStep, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Pre-Flight System Check" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Verifying system requirements before beginning installation." FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,16" />

                    <ItemsControl ItemsSource="{Binding Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                                Background="#14281E" BorderBrush="{StaticResource AccentSuccess}" BorderThickness="1"
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSuccess}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#A1A1AA" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- STEP 4: INSTALLING PROGRESS -->
            <Grid Grid.Row="0" Margin="28,24,28,16" Visibility="{Binding IsInstallingStep, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Installing DocLayer..." FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                    <TextBlock Text="Please wait while files and shortcuts are being configured." FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,24" />

                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" Margin="0,0,0,12" />

                    <Grid>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- STEP 5: COMPLETED -->
            <Grid Grid.Row="0" Margin="28,24,28,16" Visibility="{Binding IsCompletedStep, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#14281E" BorderBrush="{StaticResource AccentSuccess}" BorderThickness="1"
                            HorizontalAlignment="Left" Margin="0,0,0,16">
                        <TextBlock Text="✓" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentSuccess}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Installation Completed" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                    <TextBlock Text="DocLayer has been successfully installed on your computer." FontSize="13" Foreground="#D4D4D8" Margin="0,0,0,24" />

                    <CheckBox Content="Launch DocLayer now" IsChecked="{Binding LaunchAppOnFinish}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8" />
                </StackPanel>
            </Grid>

            <!-- STEP 6: UNINSTALL MODE -->
            <Grid Grid.Row="0" Margin="28,24,28,16" Visibility="{Binding IsUninstallStep, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Uninstall DocLayer" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                    <TextBlock Text="Are you sure you want to remove DocLayer and all of its shortcuts from your system?"
                               FontSize="13" Foreground="#D4D4D8" Margin="0,0,0,24" />

                    <Button Command="{Binding StartUninstallCommand}" Content="Uninstall Now" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Width="140" />
                </StackPanel>
            </Grid>

            <!-- STEP 7: UNINSTALLED SUCCESS -->
            <Grid Grid.Row="0" Margin="28,24,28,16" Visibility="{Binding IsUninstalledStep, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DocLayer Uninstalled" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                    <TextBlock Text="DocLayer has been successfully removed from your computer." FontSize="13" Foreground="#D4D4D8" Margin="0,0,0,24" />
                    <Button Command="{Binding CancelCommand}" Content="Close" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Width="120" />
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- BOTTOM ACTIONS BAR                                       -->
            <!-- ======================================================== -->
            <Border Grid.Row="1" Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Cancel"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                            Visibility="{Binding CanShowCancelButton, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding PrevStepCommand}" Content="&lt; Back"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Visibility="{Binding CanShowBackButton, Converter={StaticResource BoolToVis}}" />

                        <Button Command="{Binding NextStepCommand}" Content="{Binding NextButtonText}"
                                Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding CanShowNextButton, Converter={StaticResource BoolToVis}}" />

                        <Button Command="{Binding FinishCommand}" Content="Finish"
                                Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding CanShowFinishButton, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
