<Application x:Class="WordBarcodeStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Sleek Pitch Black Fallback Palette (replaced at runtime by ThemeManager) -->
        <SolidColorBrush x:Key="AppBg" Color="#0A0A0A" />
        <SolidColorBrush x:Key="SidebarBg" Color="#121212" />
        <SolidColorBrush x:Key="SidebarBorder" Color="#1E1E1E" />
        <SolidColorBrush x:Key="HeaderBg" Color="#121212" />
        <SolidColorBrush x:Key="HeaderBorder" Color="#1E1E1E" />
        <SolidColorBrush x:Key="CardBg" Color="#161616" />
        <SolidColorBrush x:Key="CardBorder" Color="#242424" />
        <SolidColorBrush x:Key="CardBgElevated" Color="#1C1C1C" />
        <SolidColorBrush x:Key="CardBorderSubtle" Color="#202020" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA" />
        <SolidColorBrush x:Key="MutedText" Color="#71717A" />
        <SolidColorBrush x:Key="FieldLabelFg" Color="#A1A1AA" />
        <SolidColorBrush x:Key="InputText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryBrand" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentPurple" Color="#A1A1AA" />
        <SolidColorBrush x:Key="AccentCyan" Color="#E4E4E7" />
        <SolidColorBrush x:Key="PrimaryBtnBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryBtnHover" Color="#E4E4E7" />
        <SolidColorBrush x:Key="PrimaryBtnFg" Color="#000000" />
        <SolidColorBrush x:Key="SecondaryBtnBg" Color="#1A1A1A" />
        <SolidColorBrush x:Key="SecondaryBtnHover" Color="#262626" />
        <SolidColorBrush x:Key="SecondaryBtnFg" Color="#F4F4F5" />
        <SolidColorBrush x:Key="SecondaryBtnBorder" Color="#2E2E2E" />
        <SolidColorBrush x:Key="TextBoxBg" Color="#0F0F0F" />
        <SolidColorBrush x:Key="TextBoxBorder" Color="#262626" />
        <SolidColorBrush x:Key="TextBoxFocusBorder" Color="#52525B" />
        <SolidColorBrush x:Key="ControlBorder" Color="#262626" />
        <SolidColorBrush x:Key="NavActiveBg" Color="#242424" />
        <SolidColorBrush x:Key="NavActiveBorder" Color="#52525B" />
        <SolidColorBrush x:Key="NavActiveFg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="NavInactiveFg" Color="#A1A1AA" />
        <SolidColorBrush x:Key="NavHoverBg" Color="#1A1A1A" />
        <SolidColorBrush x:Key="PreviewBg" Color="#0E0E0E" />
        <SolidColorBrush x:Key="PreviewBorder" Color="#1E1E1E" />
        <SolidColorBrush x:Key="PreviewSheetBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PreviewSheetBorder" Color="#333333" />
        <SolidColorBrush x:Key="CodeBlockBg" Color="#0D0D0D" />
        <SolidColorBrush x:Key="CodeBlockBorder" Color="#222222" />
        <SolidColorBrush x:Key="CodeBlockFg" Color="#38BDF8" />
        <SolidColorBrush x:Key="StatusBg" Color="#0F0F0F" />
        <SolidColorBrush x:Key="StatusFg" Color="#A1A1AA" />
        <SolidColorBrush x:Key="StatusSuccess" Color="#22C55E" />
        <SolidColorBrush x:Key="StatusWarning" Color="#F59E0B" />
        <SolidColorBrush x:Key="StatusError" Color="#EF4444" />
        <SolidColorBrush x:Key="StatusInfo" Color="#FFFFFF" />

        <!-- Logo drawing fallback -->
        <DrawingImage x:Key="LogoDrawing">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#18181B">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="16,16,224,224" RadiusX="46" RadiusY="46" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="70,50,126,156" RadiusX="14" RadiusY="14" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#18181B">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="92,78,40,40" RadiusX="6" RadiusY="6" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

