<Window x:Class="WordBarcodeStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WordBarcodeStudio.Converters"
        xmlns:models="clr-namespace:WordBarcodeStudio.Models"
        Title="DocLayer - Automation Layer for Microsoft Word"
        Icon="{DynamicResource LogoDrawing}"
        Width="1120" Height="820"
        MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Background="{DynamicResource AppBg}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:ControlToVisibilityConverter x:Key="ControlToVis" />
        <conv:ViewEqualsVisibilityConverter x:Key="ViewToVis" />
        <conv:ViewEqualsBoolConverter x:Key="ViewToBool" />
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />

        <!-- Dynamic per-type option row template -->
        <DataTemplate x:Key="OptionTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource FieldLabelFg}"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Items}"
                              DisplayMemberPath="Display" SelectedValuePath="Value"
                              SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                              Width="180" Height="34"
                              Visibility="{Binding Control, Converter={StaticResource ControlToVis}, ConverterParameter=ComboBox}" />
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" Height="34" VerticalContentAlignment="Center"
                             Visibility="{Binding Control, Converter={StaticResource ControlToVis}, ConverterParameter=Number}" />
                    <CheckBox IsChecked="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center"
                              Visibility="{Binding Control, Converter={StaticResource ControlToVis}, ConverterParameter=CheckBox}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="240" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- LEFT SIDEBAR                                                 -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Items -->
                    <RowDefinition Height="*" />
                    <!-- Status & Meta Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Brand Logo & Name -->
                <Border Grid.Row="0" Padding="20,20,20,16"
                        BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="8"
                                Background="{DynamicResource CardBgElevated}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                Margin="0,0,12,0">
                            <Image Source="{DynamicResource LogoDrawing}" Width="28" Height="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DocLayer" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Word Automation" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource MutedText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Navigation Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,16,12,16">
                    <StackPanel>
                        <!-- Section Label -->
                        <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedText}" Margin="10,0,0,8" />

                        <!-- Generate (Primary) -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Generate"
                                Cursor="Hand" Margin="0,0,0,4" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="navBorder" CornerRadius="8" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGenerateTabActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource IconSparkleGeo}"
                                                  Stretch="Uniform" Width="16" Height="16"
                                                  VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource NavInactiveFg}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGenerateTabActive}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource NavActiveFg}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Grid.Column="1" Text="Generate" FontSize="13"
                                                       VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource NavInactiveFg}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGenerateTabActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Active Dot Indicator -->
                                            <Ellipse Grid.Column="2" Width="6" Height="6"
                                                     Fill="{DynamicResource NavActiveFg}" VerticalAlignment="Center"
                                                     Visibility="{Binding IsGenerateTabActive, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource NavHoverBg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- History -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="History"
                                Cursor="Hand" Margin="0,0,0,4" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="navBorder" CornerRadius="8" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHistoryTabActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource IconHistoryGeo}"
                                                  Stretch="Uniform" Width="16" Height="16"
                                                  VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource NavInactiveFg}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHistoryTabActive}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource NavActiveFg}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Grid.Column="1" Text="History" FontSize="13"
                                                       VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource NavInactiveFg}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHistoryTabActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Ellipse Grid.Column="2" Width="6" Height="6"
                                                     Fill="{DynamicResource NavActiveFg}" VerticalAlignment="Center"
                                                     Visibility="{Binding IsHistoryTabActive, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource NavHoverBg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Templates -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Templates"
                                Cursor="Hand" Margin="0,0,0,4" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="navBorder" CornerRadius="8" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTemplatesTabActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource IconTemplatesGeo}"
                                                  Stretch="Uniform" Width="16" Height="16"
                                                  VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource NavInactiveFg}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTemplatesTabActive}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource NavActiveFg}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Grid.Column="1" Text="Templates" FontSize="13"
                                                       VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource NavInactiveFg}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTemplatesTabActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Ellipse Grid.Column="2" Width="6" Height="6"
                                                     Fill="{DynamicResource NavActiveFg}" VerticalAlignment="Center"
                                                     Visibility="{Binding IsTemplatesTabActive, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource NavHoverBg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- System Section -->
                        <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedText}" Margin="10,18,0,8" />

                        <!-- Settings -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                Cursor="Hand" Margin="0,0,0,4" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="navBorder" CornerRadius="8" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSettingsTabActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource IconSettingsGeo}"
                                                  Stretch="Uniform" Width="16" Height="16"
                                                  VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource NavInactiveFg}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSettingsTabActive}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource NavActiveFg}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Grid.Column="1" Text="Settings" FontSize="13"
                                                       VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource NavInactiveFg}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSettingsTabActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Ellipse Grid.Column="2" Width="6" Height="6"
                                                     Fill="{DynamicResource NavActiveFg}" VerticalAlignment="Center"
                                                     Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource NavHoverBg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- About -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="About"
                                Cursor="Hand" Margin="0,0,0,4" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="navBorder" CornerRadius="8" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAboutTabActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource IconAboutGeo}"
                                                  Stretch="Uniform" Width="16" Height="16"
                                                  VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource NavInactiveFg}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAboutTabActive}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource NavActiveFg}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Grid.Column="1" Text="About" FontSize="13"
                                                       VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource NavInactiveFg}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAboutTabActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Ellipse Grid.Column="2" Width="6" Height="6"
                                                     Fill="{DynamicResource NavActiveFg}" VerticalAlignment="Center"
                                                     Visibility="{Binding IsAboutTabActive, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource NavHoverBg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Word Engine Status Card & Version Footer -->
                <Border Grid.Row="2" Padding="14,14,14,14"
                        BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource StatusBg}">
                    <StackPanel>
                        <!-- Word Engine Status -->
                        <Border Background="{DynamicResource CardBgElevated}" CornerRadius="8"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Status dot -->
                                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{Binding WordStatus, Converter={StaticResource StatusToBrush}}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Word Automation" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding WordStatus}" FontSize="10"
                                               Foreground="{DynamicResource MutedText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Runtime & Version -->
                        <TextBlock Text="DocLayer v0.1.0 • net8.0-windows" FontSize="10"
                                   Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- MAIN CONTENT AREA                                            -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Modern Top Header -->
                <RowDefinition Height="Auto" />
                <!-- Active Workspace View -->
                <RowDefinition Height="*" />
                <!-- Bottom Minimal Status Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource HeaderBorder}" BorderThickness="0,0,0,1"
                    Padding="24,14,24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Tagline -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DocLayer" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text=" • " FontSize="14" Foreground="{DynamicResource MutedText}" />
                            <TextBlock Text="{Binding CurrentTab}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrand}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="A programmable automation layer for Microsoft Word documents."
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Header Controls: Word Badge & Theme Switcher -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Word Engine Quick Badge -->
                        <Border Background="{DynamicResource CardBgElevated}" CornerRadius="16"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                         Fill="{Binding GenerationStatus, Converter={StaticResource StatusToBrush}}" />
                                <TextBlock Text="{Binding GenerationStatus}" FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <!-- Theme Toggle Button -->
                        <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource ToolButton}"
                                ToolTip="Toggle Dark/Light Mode">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0"
                                      Fill="{DynamicResource PrimaryBrand}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource IconSunGeo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource IconMoonGeo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding ThemeButtonLabel}" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- VIEW CONTAINER                                           -->
            <!-- ======================================================== -->
            <Grid Grid.Row="1" Margin="24,18,24,14">

                <!-- ==================================================== -->
                <!-- 1. GENERATE VIEW                                     -->
                <!-- ==================================================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentTab, Converter={StaticResource ViewToVis}, ConverterParameter=Generate}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Configuration & Input Column -->
                            <ColumnDefinition Width="1.1*" MinWidth="340" />
                            <!-- Document Workspace & Inspector Column -->
                            <ColumnDefinition Width="*" MinWidth="320" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Input, Configuration, Options, Primary Generate -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">

                            <!-- Section 1: Barcode Data -->
                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Barcode Data" Style="{StaticResource FieldLabelText}" Margin="0" />
                                        <TextBlock Text="Word DISPLAYBARCODE source" FontSize="11"
                                                   Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="Enter the text, URL, or data payload Word should encode."
                                               Style="{StaticResource SubfieldText}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding Settings.Data, UpdateSourceTrigger=PropertyChanged}"
                                             Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" />
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Barcode Type & Execution Mode -->
                            <Border Style="{StaticResource ModernCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Barcode Type Selector -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Barcode Type" Style="{StaticResource FieldLabelText}" />
                                        <ComboBox ItemsSource="{Binding BarcodeTypes}"
                                                  SelectedItem="{Binding SelectedBarcodeType}" />
                                    </StackPanel>

                                    <!-- Right: Background Mode Toggle -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Word Engine Mode" Style="{StaticResource FieldLabelText}" />
                                        <CheckBox Content="Run Word in background"
                                                  IsChecked="{Binding Settings.RunWordInBackground}"
                                                  Margin="0,4,0,2" />
                                        <TextBlock Text="Keep Word hidden during automation"
                                                   Style="{StaticResource SubfieldText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Section 3: Dynamic Options & Advanced Configuration -->
                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock Text="Barcode Options" Style="{StaticResource FieldLabelText}" />
                                    <!-- Dynamic Per-Type Options -->
                                    <ItemsControl ItemsSource="{Binding BasicOptions}"
                                                  ItemTemplate="{StaticResource OptionTemplate}" />

                                    <!-- Advanced Options Drawer -->
                                    <Expander Header="Advanced options" Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding AdvancedOptions}"
                                                      ItemTemplate="{StaticResource OptionTemplate}"
                                                      Margin="0,8,0,0" />
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Section 4: Primary Action & Export Buttons -->
                            <Border Style="{StaticResource ElevatedCard}">
                                <StackPanel>
                                    <!-- Primary Generate Action Button -->
                                    <Button Command="{Binding GenerateCommand}"
                                            Style="{StaticResource PrimaryGradientButton}"
                                            Height="46" Margin="0,0,0,12"
                                            IsEnabled="{Binding IsGenerating, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSparkleGeo}" Fill="#FFFFFF"
                                                  Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding GenerateButtonLabel}" FontSize="13" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Secondary Actions Row -->
                                    <UniformGrid Columns="3" Rows="1">
                                        <!-- Open in Word -->
                                        <Button Command="{Binding OpenCommand}"
                                                Style="{StaticResource SecondaryModernButton}"
                                                IsEnabled="{Binding CanAct}" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconExternalLinkGeo}"
                                                      Fill="{DynamicResource SecondaryBtnFg}"
                                                      Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" />
                                                <TextBlock Text="Open in Word" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Save DOCX -->
                                        <Button Command="{Binding SaveDocxCommand}"
                                                Style="{StaticResource SecondaryModernButton}"
                                                IsEnabled="{Binding CanAct}" Margin="4,0,4,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconSaveDocxGeo}"
                                                      Fill="{DynamicResource SecondaryBtnFg}"
                                                      Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" />
                                                <TextBlock Text="Save DOCX" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Export PDF -->
                                        <Button Command="{Binding ExportPdfCommand}"
                                                Style="{StaticResource SecondaryModernButton}"
                                                IsEnabled="{Binding CanAct}" Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconPdfGeo}"
                                                      Fill="{DynamicResource SecondaryBtnFg}"
                                                      Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" />
                                                <TextBlock Text="Export PDF" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- RIGHT COLUMN: Document Workspace Preview & Developer Field Code Inspector -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">

                            <!-- Section 5: Document Preview Workspace -->
                            <Border Style="{StaticResource ModernCard}" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Document Preview" Style="{StaticResource FieldLabelText}" Margin="0" />
                                            <TextBlock Text="Materialized via Microsoft Word COM engine"
                                                       Style="{StaticResource SubfieldText}" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{DynamicResource CardBgElevated}" CornerRadius="4"
                                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                                Padding="6,2" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Word Rendered" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource StatusSuccess}" />
                                        </Border>
                                    </Grid>

                                    <!-- Workspace Canvas Area -->
                                    <Border Background="{DynamicResource PreviewBg}"
                                            BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1"
                                            CornerRadius="8" Height="250" Padding="14">
                                        <Grid>
                                            <!-- Empty State -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <Border Width="48" Height="48" CornerRadius="24"
                                                        Background="{DynamicResource CardBgElevated}"
                                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Data="{StaticResource IconWordDocGeo}"
                                                          Fill="{DynamicResource MutedText}"
                                                          Stretch="Uniform" Width="20" Height="20"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="No preview yet" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Generate a barcode to preview the Word document result."
                                                           FontSize="12" Foreground="{DynamicResource MutedText}"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center" />
                                            </StackPanel>

                                            <!-- Paper Sheet Canvas when Image Generated -->
                                            <Border Background="{DynamicResource PreviewSheetBg}"
                                                    BorderBrush="{DynamicResource PreviewSheetBorder}" BorderThickness="1"
                                                    CornerRadius="6" Padding="12"
                                                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    MaxHeight="220" MaxWidth="320">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.12" Color="#000000" />
                                                </Border.Effect>
                                                <Image Source="{Binding PreviewImage}"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Section 6: Developer Word Field Code Inspector -->
                            <Border Style="{StaticResource ModernCard}" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Generated Word Field" Style="{StaticResource FieldLabelText}" Margin="0" />
                                            <TextBlock Text="Word DISPLAYBARCODE instruction" Style="{StaticResource SubfieldText}" />
                                        </StackPanel>
                                        <!-- Copy Button -->
                                        <Button Command="{Binding CopyFieldCodeCommand}"
                                                Style="{StaticResource ToolButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconCopyGeo}"
                                                      Fill="{DynamicResource TextSecondary}"
                                                      Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding CopyFeedbackText}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Monospace Code Box -->
                                    <Border Background="{DynamicResource CodeBlockBg}"
                                            BorderBrush="{DynamicResource CodeBlockBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="10" MinHeight="70">
                                        <TextBox Text="{Binding FieldCodePreview}"
                                                 IsReadOnly="True"
                                                 FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource CodeBlockFg}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top" />
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ==================================================== -->
                <!-- 2. HISTORY VIEW                                      -->
                <!-- ==================================================== -->
                <Grid Visibility="{Binding CurrentTab, Converter={StaticResource ViewToVis}, ConverterParameter=History}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- History Header Actions -->
                    <Border Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Session History" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Barcodes and documents generated during the active session."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ClearHistoryCommand}"
                                    Style="{StaticResource ToolButton}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrashGeo}" Fill="{DynamicResource TextSecondary}"
                                          Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" />
                                    <TextBlock Text="Clear History" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- History List or Empty State -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="16">
                        <Grid>
                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HistoryItems.Count, Converter={StaticResource ControlToVis}, ConverterParameter=0}">
                                <Border Width="48" Height="48" CornerRadius="24"
                                        Background="{DynamicResource CardBgElevated}"
                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Path Data="{StaticResource IconHistoryGeo}"
                                          Fill="{DynamicResource MutedText}"
                                          Stretch="Uniform" Width="20" Height="20"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No generation history yet" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="Generated documents in this session will be logged here for quick inspection."
                                           FontSize="12" Foreground="{DynamicResource MutedText}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Items List -->
                            <ListBox ItemsSource="{Binding HistoryItems}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:GenerationHistoryItem}">
                                        <Border Style="{StaticResource ModernCard}" Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Type Badge -->
                                                <Border Grid.Column="0" Background="{DynamicResource NavActiveBg}"
                                                        CornerRadius="6" Padding="8,4" Margin="0,0,14,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BarcodeType}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource NavActiveFg}" />
                                                </Border>

                                                <!-- Data & Field Code -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TruncatedData}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding FieldCode}" FontSize="11"
                                                               FontFamily="Cascadia Code, Consolas"
                                                               Foreground="{DynamicResource CodeBlockFg}" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding TimeFormatted}" FontSize="10"
                                                               Foreground="{DynamicResource MutedText}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Action: Select -->
                                                <Button Grid.Column="2" Content="Restore"
                                                        Command="{Binding DataContext.SelectHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryModernButton}"
                                                        VerticalAlignment="Center" Padding="10,6" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================================================== -->
                <!-- 3. TEMPLATES VIEW                                    -->
                <!-- ==================================================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentTab, Converter={StaticResource ViewToVis}, ConverterParameter=Templates}">
                    <StackPanel>
                        <!-- Header -->
                        <Border Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Document Templates" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Create, manage, and automate structured Word document templates with dynamic barcode layers."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Template Workspace Notice Card -->
                        <Border Style="{StaticResource ModernCard}" Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,20">
                                <Border Width="56" Height="56" CornerRadius="28"
                                        Background="{DynamicResource CardBgElevated}"
                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Path Data="{StaticResource IconTemplatesGeo}"
                                          Fill="{DynamicResource PrimaryBrand}"
                                          Stretch="Uniform" Width="24" Height="24"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Template Workspace" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="DocLayer's upcoming template engine will allow batch binding Excel and JSON data directly into Word documents."
                                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" Margin="0,6,0,16" TextAlignment="Center" MaxWidth="500" />

                                <Border Background="{DynamicResource CardBgElevated}" CornerRadius="8"
                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                        Padding="14" MaxWidth="480">
                                    <StackPanel>
                                        <TextBlock Text="Upcoming Capabilities:" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                        <TextBlock Text="• Multi-page batch barcode insertion" FontSize="11" Foreground="{DynamicResource MutedText}" />
                                        <TextBlock Text="• Word document placeholder replacement ({% BARCODE %})" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,3,0,0" />
                                        <TextBlock Text="• Automated bulk PDF generation" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== -->
                <!-- 4. SETTINGS VIEW                                     -->
                <!-- ==================================================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentTab, Converter={StaticResource ViewToVis}, ConverterParameter=Settings}">
                    <StackPanel>
                        <!-- Header -->
                        <Border Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Settings &amp; Preferences" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Configure runtime defaults, Word automation engine behaviors, and theme preferences."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Appearance Section -->
                        <Border Style="{StaticResource ModernCard}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource FieldLabelText}" />
                                <TextBlock Text="Customize the visual interface of DocLayer." Style="{StaticResource SubfieldText}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Color Theme" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Switch between Dark and Light mode" FontSize="11"
                                                   Foreground="{DynamicResource MutedText}" />
                                    </StackPanel>
                                    <Button Command="{Binding ToggleThemeCommand}"
                                            Style="{StaticResource SecondaryModernButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6">
                                        <TextBlock Text="{Binding ThemeButtonLabel}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Word Engine Section -->
                        <Border Style="{StaticResource ModernCard}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Microsoft Word Automation" Style="{StaticResource FieldLabelText}" />
                                <TextBlock Text="Manage COM integration parameters and scratch cache." Style="{StaticResource SubfieldText}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Background Execution" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Keep Word processes hidden during barcode generation" FontSize="11"
                                                   Foreground="{DynamicResource MutedText}" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding Settings.RunWordInBackground}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Temporary Output Cache" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding WordTempDirectory}" FontSize="11"
                                                   Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                                    </StackPanel>
                                    <Button Command="{Binding OpenTempFolderCommand}"
                                            Style="{StaticResource SecondaryModernButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFolderGeo}" Fill="{DynamicResource SecondaryBtnFg}"
                                                  Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Open Cache" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== -->
                <!-- 5. ABOUT VIEW                                        -->
                <!-- ==================================================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentTab, Converter={StaticResource ViewToVis}, ConverterParameter=About}">
                    <StackPanel>
                        <!-- Header -->
                        <Border Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="About DocLayer" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="A programmable automation layer for Microsoft Word documents."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCard}" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Image Source="{DynamicResource LogoDrawing}" Width="44" Height="44" Margin="0,0,16,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="DocLayer" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Version 0.1.0 • net8.0-windows" FontSize="12"
                                                   Foreground="{DynamicResource MutedText}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Architecture &amp; Philosophy" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                <TextBlock Text="DocLayer leverages Microsoft Word's native COM automation engine and DISPLAYBARCODE field codes to generate vector-accurate barcodes, QR codes, and formatted documents without relying on external 3rd-party rendering libraries. The output is 100% native Word and PDF compatible."
                                           FontSize="13" LineHeight="20" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" />

                                <TextBlock Text="Supported Formats" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                <TextBlock Text="• QR Codes (with Error Correction L, M, Q, H)&#x0a;• Code 128, Code 39&#x0a;• EAN-13, EAN-8&#x0a;• UPC-A, UPC-E&#x0a;• ITF-14"
                                           FontSize="12" LineHeight="18" Foreground="{DynamicResource MutedText}" Margin="0,0,0,16" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Bottom Minimal Status Bar -->
            <Border Grid.Row="2" Background="{DynamicResource StatusBg}"
                    BorderBrush="{DynamicResource HeaderBorder}" BorderThickness="0,1,0,0"
                    Padding="24,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                 Fill="{Binding GenerationStatus, Converter={StaticResource StatusToBrush}}" />
                        <TextBlock Text="{Binding GenerationStatus}" FontSize="11"
                                   Foreground="{DynamicResource StatusFg}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="DocLayer Engine • Active" FontSize="11"
                               Foreground="{DynamicResource MutedText}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
